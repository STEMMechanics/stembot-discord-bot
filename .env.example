# Discord application credentials. Never commit the real values.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-id

# Docker Compose image selection. The default image is published from main.
# Use a version tag or immutable sha tag for a controlled deployment.
STEMBOT_IMAGE=ghcr.io/stemmechanics/stembot-discord-bot
STEMBOT_IMAGE_TAG=latest
# Explicit container DNS resolvers. Override these for the deployment network.
STEMBOT_DNS_PRIMARY=1.1.1.1
STEMBOT_DNS_SECONDARY=9.9.9.9

# The bot clears global commands at startup and registers supported commands in
# this target guild. The single-server deployment requires this value.
DISCORD_GUILD_ID=replace-with-target-guild-id

NODE_ENV=development
LOG_LEVEL=info
STATE_PATH=./data/state.json
SHUTDOWN_TIMEOUT_MS=30000

# External data sources.
WORKSHOP_FEED_URL=https://www.stemmechanics.com.au/workshops/feed
WEBSITE_REQUEST_TIMEOUT_MS=15000
STEMCRAFT_STATUS_URL=http://play.stemcraft.com.au:8950/status
STEMCRAFT_REQUEST_TIMEOUT_MS=5000
# STEMCRAFT_STATUS_TOKEN=replace-with-bearer-token-if-required

# Uptime Kuma status card. The status page must be published and the URL must
# use Uptime Kuma's normal /status/<slug> form. The bot creates its Discord
# message on the first sync and stores the message ID in STATE_PATH.
UPTIME_KUMA_ENABLED=false
# UPTIME_KUMA_STATUS_PAGE_URL=https://uptime.example.com/status/stemmechanics
UPTIME_KUMA_POLL_INTERVAL_MS=60000
UPTIME_KUMA_REQUEST_TIMEOUT_MS=10000
# DISCORD_UPTIME_STATUS_CHANNEL_ID=replace-with-status-channel-id

# Counting-chain minigame. It listens only in the configured channel and is
# disabled until both the channel and OpenAI credentials are supplied.
COUNTING_CHAIN_ENABLED=false
# COUNTING_CHAIN_CHANNEL_ID=replace-with-counting-channel-id
# COUNTING_CHAIN_INFO_CHANNEL_ID=replace-with-counting-info-channel-id
# COUNTING_CHAIN_INFO_MESSAGE_ID=replace-with-existing-info-message-id
# Set this to let STEMBot pause uncertain posts and ask moderators for a review.
COUNTING_CHAIN_REVIEW_ENABLED=false
# Required when COUNTING_CHAIN_REVIEW_ENABLED=true. Make the role mentionable.
# COUNTING_CHAIN_REVIEW_ROLE_ID=replace-with-moderator-role-id
COUNTING_CHAIN_MAX_ATTACHMENT_BYTES=8388608
# OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Shared by counting-chain image recognition and the STEM quiz. Low avoids
# spending the entire response budget on hidden reasoning for routine calls.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=180

# AI STEM question chain. It uses the OpenAI settings above and posts one
# question at a time in the configured channel.
STEM_QUIZ_ENABLED=false
# STEM_QUIZ_CHANNEL_ID=replace-with-quiz-channel-id
STEM_QUIZ_MAX_WRONG_ANSWERS=5
STEM_QUIZ_TARGET_AGE_MIN=8
STEM_QUIZ_TARGET_AGE_MAX=14
STEM_QUIZ_OLDER_AGE_MAX=18
STEM_QUIZ_OLDER_PLAYER_RATE=0.15
STEM_QUIZ_TOPIC=a balanced mix of science, technology, engineering, mathematics, space, nature, robotics and computing
STEM_QUIZ_RETRY_INTERVAL_MS=300000

# AI word scramble. The bot asks the shared OpenAI model for a suitable word,
# then scrambles it locally and waits for answers in this channel.
STEM_SCRAMBLE_ENABLED=false
# STEM_SCRAMBLE_CHANNEL_ID=replace-with-scramble-channel-id
STEM_SCRAMBLE_RETRY_INTERVAL_MS=300000
STEM_SCRAMBLE_TARGET_AGE_MIN=8
STEM_SCRAMBLE_TARGET_AGE_MAX=14
STEM_SCRAMBLE_TOPIC=a balanced mix of science, technology, engineering, mathematics, space, nature, robotics and computing

# Participation XP and levels. Messages earn XP with a per-user cooldown;
# reactions and accepted minigame moves have their own safeguards/rewards.
STEM_LEVELS_ENABLED=false
# Optional channel for public level-up announcements.
# STEM_LEVELS_ANNOUNCEMENT_CHANNEL_ID=replace-with-level-announcement-channel-id
STEM_LEVELS_MESSAGE_XP=5
STEM_LEVELS_REACTION_XP=2
STEM_LEVELS_GAME_XP=15
STEM_LEVELS_MESSAGE_COOLDOWN_SECONDS=60
STEM_LEVELS_REACTION_COOLDOWN_SECONDS=30

# Workshop synchronization and notification settings.
WORKSHOP_TIME_ZONE=Australia/Brisbane
WORKSHOP_POLL_INTERVAL_MS=300000
WORKSHOP_ANNOUNCEMENTS_ENABLED=true
# Only announce workshops within this many days of their start.
WORKSHOP_ANNOUNCEMENT_WINDOW_DAYS=28
# Wait before posting lifecycle announcements so early feed changes are included.
# Set to 0 for immediate announcements while testing.
WORKSHOP_ANNOUNCEMENT_DELAY_MINUTES=30
WORKSHOP_REMINDERS_ENABLED=true
WORKSHOP_REMINDER_24H_ENABLED=true
WORKSHOP_REMINDER_1H_ENABLED=true
WORKSHOP_ANNOUNCE_INITIAL_SYNC=false
# DISCORD_WORKSHOP_ANNOUNCEMENT_CHANNEL_ID=replace-with-channel-id
# DISCORD_WORKSHOP_REMINDER_CHANNEL_ID=replace-with-channel-id

# Streaming notifications are reserved until their workflow is agreed.
STREAMING_NOTIFICATIONS_ENABLED=false
# DISCORD_STREAMING_NOTIFICATION_CHANNEL_ID=replace-with-channel-id
