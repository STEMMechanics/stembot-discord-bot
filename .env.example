# Discord application credentials. Never commit the real values.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-application-id

# Docker Compose image selection. The default image is published from main.
# Use a version tag or immutable sha tag for a controlled deployment.
STEMBOT_IMAGE=ghcr.io/stemmechanics/stembot-discord-bot
STEMBOT_IMAGE_TAG=latest
# Explicit container DNS resolvers. Override these for the deployment network.
STEMBOT_DNS_PRIMARY=1.1.1.1
STEMBOT_DNS_SECONDARY=9.9.9.9

# The bot clears global commands at startup and registers supported commands in
# this target guild. The single-server deployment requires this value.
DISCORD_GUILD_ID=replace-with-target-guild-id

NODE_ENV=development
LOG_LEVEL=info
STATE_PATH=./data/state.json
SHUTDOWN_TIMEOUT_MS=30000

# External data sources.
WORKSHOP_FEED_URL=https://www.stemmechanics.com.au/workshops/feed
WEBSITE_REQUEST_TIMEOUT_MS=15000
STEMCRAFT_STATUS_URL=http://play.stemcraft.com.au:8950/status
STEMCRAFT_REQUEST_TIMEOUT_MS=5000
# STEMCRAFT_STATUS_TOKEN=replace-with-bearer-token-if-required

# Uptime Kuma status card. The status page must be published and the URL must
# use Uptime Kuma's normal /status/<slug> form. The bot creates its Discord
# message on the first sync and stores the message ID in STATE_PATH.
UPTIME_KUMA_ENABLED=false
# UPTIME_KUMA_STATUS_PAGE_URL=https://uptime.example.com/status/stemmechanics
UPTIME_KUMA_POLL_INTERVAL_MS=60000
UPTIME_KUMA_REQUEST_TIMEOUT_MS=10000
# DISCORD_UPTIME_STATUS_CHANNEL_ID=replace-with-status-channel-id

# Counting-chain minigame. It listens only in the configured channel and is
# disabled until both the channel and OpenAI credentials are supplied.
COUNTING_CHAIN_ENABLED=false
# COUNTING_CHAIN_CHANNEL_ID=replace-with-counting-channel-id
# COUNTING_CHAIN_INFO_CHANNEL_ID=replace-with-minigame-dashboard-channel-id
# COUNTING_CHAIN_INFO_MESSAGE_ID=replace-with-existing-info-message-id
# Set this to let STEMBot pause uncertain posts and ask moderators for a review.
COUNTING_CHAIN_REVIEW_ENABLED=false
# Required when COUNTING_CHAIN_REVIEW_ENABLED=true. Make the role mentionable.
# COUNTING_CHAIN_REVIEW_ROLE_ID=replace-with-moderator-role-id
COUNTING_CHAIN_MAX_ATTACHMENT_BYTES=8388608
# After this many milliseconds without a new image, post one playful reminder.
# The default is three days; the reminder does not change the expected number.
COUNTING_CHAIN_IDLE_NUDGE_MS=259200000
# OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-6-luna
# Shared by counting-chain image recognition and the STEM quiz. Low avoids
# spending the entire response budget on hidden reasoning for routine calls.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=180

# AI STEM question chain. It uses the OpenAI settings above and posts one
# question at a time in the configured channel.
STEM_QUIZ_ENABLED=false
# STEM_QUIZ_CHANNEL_ID=replace-with-quiz-channel-id
STEM_QUIZ_MAX_WRONG_ANSWERS=5
STEM_QUIZ_TARGET_AGE_MIN=8
STEM_QUIZ_TARGET_AGE_MAX=14
STEM_QUIZ_OLDER_AGE_MAX=18
STEM_QUIZ_OLDER_PLAYER_RATE=0.15
STEM_QUIZ_TOPIC=a balanced mix of science, technology, engineering, mathematics, space, nature, robotics and computing
STEM_QUIZ_RETRY_INTERVAL_MS=300000
# After this many milliseconds without an answer, reveal the answer and post a
# fresh question. The existing scores are kept. The default is three days.
STEM_QUIZ_IDLE_TIMEOUT_MS=259200000

# AI word scramble. The bot asks the shared OpenAI model for a suitable word,
# then scrambles it locally and waits for answers in this channel.
STEM_SCRAMBLE_ENABLED=false
# STEM_SCRAMBLE_CHANNEL_ID=replace-with-scramble-channel-id
STEM_SCRAMBLE_RETRY_INTERVAL_MS=300000
STEM_SCRAMBLE_TARGET_AGE_MIN=8
STEM_SCRAMBLE_TARGET_AGE_MAX=14
STEM_SCRAMBLE_TOPIC=a balanced mix of science, technology, engineering, mathematics, space, nature, robotics and computing
# After this many milliseconds without an answer, post one extra AI clue.
# The default is three days.
STEM_SCRAMBLE_IDLE_TIMEOUT_MS=259200000

# The themed word chain uses a local STEM vocabulary and changes theme when a
# word is outside the theme or starts with the wrong letter.
STEM_WORD_CHAIN_ENABLED=false
# STEM_WORD_CHAIN_CHANNEL_ID=replace-with-word-chain-channel-id
STEM_WORD_CHAIN_RETRY_INTERVAL_MS=300000
# After this many milliseconds without a valid word, post one extra themed
# clue. The round and streak stay open. The default is three days.
STEM_WORD_CHAIN_IDLE_TIMEOUT_MS=259200000

# Mystery Lab is a family-friendly letter guessing game. It shows one hidden
# word and one clue; members can guess a single letter or the whole word.
STEM_MYSTERY_LAB_ENABLED=false
# STEM_MYSTERY_LAB_CHANNEL_ID=replace-with-mystery-lab-channel-id
STEM_MYSTERY_LAB_RETRY_INTERVAL_MS=300000
STEM_MYSTERY_LAB_TOPIC=a varied mix of animals, nature, food, places, everyday objects, hobbies, stories, music, sport, inventions, science and technology
STEM_MYSTERY_LAB_DIFFICULTY=challenging
STEM_MYSTERY_LAB_TARGET_AGE_MIN=8
STEM_MYSTERY_LAB_TARGET_AGE_MAX=14
STEM_MYSTERY_LAB_MAX_WRONG_GUESSES=8
STEM_MYSTERY_LAB_IDLE_TIMEOUT_MS=259200000
# STEM_WORD_REVEAL_* names remain accepted as legacy aliases.

# Code Fix posts a short, child-friendly code sample with one bug. Members
# describe the fix; exact variants are checked locally and other answers are
# judged by the shared AI model.
STEM_CODE_FIX_ENABLED=false
# STEM_CODE_FIX_CHANNEL_ID=replace-with-code-fix-channel-id
STEM_CODE_FIX_RETRY_INTERVAL_MS=300000
STEM_CODE_FIX_DIFFICULTY=intermediate
STEM_CODE_FIX_TOPIC=beginner programming, debugging, algorithms, robotics and simple STEM projects
STEM_CODE_FIX_TARGET_AGE_MIN=8
STEM_CODE_FIX_TARGET_AGE_MAX=14
STEM_CODE_FIX_MAX_WRONG_ANSWERS=5
STEM_CODE_FIX_IDLE_TIMEOUT_MS=259200000

# Tic Tac Toe and Connect 4 are persistent channel games. The bot posts a
# board when it starts and players use the buttons on that board; no slash
# command is needed to begin a round.
STEM_TICTACTOE_ENABLED=false
# STEM_TICTACTOE_CHANNEL_ID=replace-with-tic-tac-toe-channel-id
STEM_TICTACTOE_RETRY_INTERVAL_MS=300000
STEM_TICTACTOE_IDLE_TIMEOUT_MS=259200000
STEM_CONNECT4_ENABLED=false
# STEM_CONNECT4_CHANNEL_ID=replace-with-connect-four-channel-id
STEM_CONNECT4_RETRY_INTERVAL_MS=300000
STEM_CONNECT4_IDLE_TIMEOUT_MS=259200000

# The Global Chase is a cooperative, three-stop location mystery. Each clue
# offers three possible destinations; players reply with a location or 1, 2,
# or 3. There is no slash command to start a case.
STEM_GLOBAL_CHASE_ENABLED=false
# STEM_GLOBAL_CHASE_CHANNEL_ID=replace-with-global-chase-channel-id
STEM_GLOBAL_CHASE_RETRY_INTERVAL_MS=300000
STEM_GLOBAL_CHASE_MAX_STRIKES=3
STEM_GLOBAL_CHASE_IDLE_TIMEOUT_MS=259200000

# Moderator reminders. Reminders are stored in STATE_PATH and posted here when
# due. Use /remind 5d "post the next challenge" or /remind 30m "check the bot".
STEM_REMINDERS_ENABLED=false
# STEM_REMINDERS_CHANNEL_ID=replace-with-admin-reminders-channel-id
STEM_REMINDERS_CHECK_INTERVAL_MS=60000

# Authenticated Minecraft chat and lifecycle-event bridge. Expose this path
# through the reverse proxy URL used by the plugin. The server and channel
# fields in incoming events are intentionally ignored; every accepted event
# goes to the one configured Discord channel.
CHAT_DISCORD_BRIDGE_ENABLED=false
CHAT_DISCORD_BRIDGE_HOST=0.0.0.0
CHAT_DISCORD_BRIDGE_PORT=8080
CHAT_DISCORD_BRIDGE_PATH=/minecraft/event
# CHAT_DISCORD_BRIDGE_BEARER_TOKEN=replace-with-long-random-token
# CHAT_DISCORD_BRIDGE_CHANNEL_ID=replace-with-minecraft-chat-channel-id
# CHAT_DISCORD_BRIDGE_STEMCRAFT_URL=https://play.example.test:8950/api/v1/chat/discord
CHAT_DISCORD_BRIDGE_MAX_BODY_BYTES=65536

# AI question answering. Members can mention STEMBot directly in any channel.
STEM_ASK_ENABLED=false
STEM_ASK_MAX_QUESTION_LENGTH=500
STEM_ASK_USER_COOLDOWN_SECONDS=30
STEM_ASK_USER_DAILY_LIMIT=10
STEM_ASK_GLOBAL_DAILY_LIMIT=100

# Participation XP and levels. Messages earn XP with a per-user cooldown;
# reactions and accepted minigame moves have their own safeguards/rewards.
STEM_LEVELS_ENABLED=false
# Optional channel for public level-up announcements.
# STEM_LEVELS_ANNOUNCEMENT_CHANNEL_ID=replace-with-level-announcement-channel-id
STEM_LEVELS_MESSAGE_XP=5
STEM_LEVELS_REACTION_XP=2
STEM_LEVELS_GAME_XP=15
STEM_LEVELS_MESSAGE_COOLDOWN_SECONDS=60
STEM_LEVELS_REACTION_COOLDOWN_SECONDS=30

# Join-date cake-day announcements. The check uses WORKSHOP_TIME_ZONE and
# runs during the configured local hour, defaulting to 8am.
STEM_CAKE_DAYS_ENABLED=false
# Required when enabled.
# STEM_CAKE_DAYS_ANNOUNCEMENT_CHANNEL_ID=replace-with-cake-day-announcement-channel-id
STEM_CAKE_DAYS_CHECK_INTERVAL_MS=60000
STEM_CAKE_DAYS_HOUR=8

# Workshop synchronization and notification settings.
WORKSHOP_TIME_ZONE=Australia/Brisbane
WORKSHOP_POLL_INTERVAL_MS=300000
WORKSHOP_ANNOUNCEMENTS_ENABLED=true
# Only announce workshops within this many days of their start.
WORKSHOP_ANNOUNCEMENT_WINDOW_DAYS=28
# Wait before posting lifecycle announcements so early feed changes are included.
# Set to 0 for immediate announcements while testing.
WORKSHOP_ANNOUNCEMENT_DELAY_MINUTES=30
WORKSHOP_REMINDERS_ENABLED=true
WORKSHOP_REMINDER_24H_ENABLED=true
WORKSHOP_REMINDER_1H_ENABLED=true
# Case-insensitive comma-separated location allow-list for reminders only.
# Use * to allow reminders for every location.
WORKSHOP_REMINDER_LOCATIONS=STEMCraft
WORKSHOP_ANNOUNCE_INITIAL_SYNC=false
# DISCORD_WORKSHOP_ANNOUNCEMENT_CHANNEL_ID=replace-with-channel-id
# DISCORD_WORKSHOP_REMINDER_CHANNEL_ID=replace-with-channel-id

# Streaming notifications are reserved until their workflow is agreed.
STREAMING_NOTIFICATIONS_ENABLED=false
# DISCORD_STREAMING_NOTIFICATION_CHANNEL_ID=replace-with-channel-id
